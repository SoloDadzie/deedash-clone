---
import SiteLayout from '../layouts/SiteLayout.astro';
import { contactDetails } from '../data/site';
---

<SiteLayout
  title="Contact Us | DeeDash Cabs"
  description="Contact DeeDash Cabs in Chester for bookings, support, lost property, and business travel enquiries."
  currentPath="/contact-us"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Contact Us</p>
      <h1>Contact DeeDash Cabs</h1>
      <p>Book a ride, ask a question, or get help &mdash; we&apos;re available 24/7.</p>
      <div class="page-hero-cta">
        <a class="btn btn-accent" href="/book-a-ride">Request a Ride</a>
        <a class="btn btn-ghost" href={`tel:${contactDetails.phoneTel}`}>Call Now</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <article class="panel reveal">
        <p class="kicker">Bookings &amp; Support</p>
        <h2>We&apos;re here 24/7</h2>
        <ul class="plain-list">
          <li><strong>Phone (24/7):</strong> {contactDetails.phone}</li>
          <li><strong>Email:</strong> {contactDetails.email}</li>
          <li><strong>WhatsApp:</strong> {contactDetails.whatsapp}</li>
        </ul>
        <div class="inline-actions">
          <a class="btn btn-primary" href="/book-a-ride">Request a Ride</a>
          <a class="btn btn-outline" href={`tel:${contactDetails.phoneTel}`}>Call Now</a>
        </div>
      </article>

      <article class="panel reveal">
        <p class="kicker">Office Address</p>
        <h2>DeeDash Cabs</h2>
        <p>{contactDetails.office}</p>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container grid-3">
      <article class="panel reveal">
        <p class="kicker">Lost Property</p>
        <h3>Left something in a vehicle?</h3>
        <p>If you left something in a vehicle, contact us as soon as possible with your journey details.</p>
        <a class="btn btn-outline" href={`tel:${contactDetails.phoneTel}`}>Call: {contactDetails.phone}</a>
      </article>

      <article class="panel reveal">
        <p class="kicker">Feedback</p>
        <h3>Help us improve</h3>
        <p>Your feedback helps us improve and serve Chester better.</p>
        <a class="btn btn-outline" href={`mailto:${contactDetails.email}`}>Send Feedback: {contactDetails.email}</a>
      </article>

      <article class="panel reveal cta-band">
        <p class="kicker">Live Chat</p>
        <h3>Coming soon</h3>
        <p>Live chat is coming soon.</p>
        <button
          class="btn btn-accent"
          type="button"
          hx-get="/partials/live-chat-status"
          hx-target="#live-chat-status"
          hx-swap="innerHTML"
          hx-indicator="#live-chat-loading"
        >
          Check status
        </button>
        <p id="live-chat-loading" class="microcopy htmx-indicator">Checking chat rollout status...</p>
        <div id="live-chat-status" class="htmx-response" aria-live="polite"></div>
      </article>
    </div>
  </section>
</SiteLayout>
