import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="DeeDash Cabs | Chester Private Hire"
  description="DeeDash Cabs offers safe, friendly private hire across Chester and nearby areas."
  currentPath="/"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Astro Migration</p>
      <h1>DEEDASH SITE REBUILD IN PROGRESS</h1>
      <p>
        The Astro + HTMX migration has been bootstrapped. Feature branches will now add all original pages and
        interactions.
      </p>
    </div>
  </section>
</SiteLayout>
