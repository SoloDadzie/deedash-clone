---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Privacy Policy | DeeDash Cabs"
  description="Dummy privacy policy page for DeeDash Cabs website."
  currentPath="/privacy-policy"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Legal</p>
      <h1>PRIVACY POLICY</h1>
      <p>This is a placeholder page for DeeDash Cabs privacy policy.</p>
      <div class="page-hero-cta">
        <a class="btn btn-accent" href="/contact-us">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">Status</p>
        <h2>DUMMY CONTENT</h2>
        <p>
          Last updated: 11 February 2026. This page is a placeholder and does not yet represent the final GDPR-compliant
          privacy notice.
        </p>
      </article>

      <article class="panel reveal">
        <p class="kicker">Data Coverage</p>
        <h2>WHAT THIS PAGE WILL COVER</h2>
        <ul class="feature-list">
          <li>What personal data DeeDash collects during bookings and enquiries</li>
          <li>How data is processed, stored, and retained</li>
          <li>Who data is shared with and why</li>
          <li>Customer rights, including access and deletion requests</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <article class="panel reveal cta-band">
        <p class="kicker">Next Step</p>
        <h2>PRIVACY TEXT PENDING</h2>
        <p>
          Replace this placeholder with a full UK GDPR and Data Protection Act compliant notice before launch.
        </p>
      </article>
    </div>
  </section>
</SiteLayout>
