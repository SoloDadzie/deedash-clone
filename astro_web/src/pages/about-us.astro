---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="About Us | DeeDash Cabs"
  description="Learn about DeeDash Cabs, our safety standards, and our community-first approach to private hire in Chester."
  currentPath="/about-us"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">About DeeDash</p>
      <h1>A better way to travel around Chester</h1>
      <p>DeeDash Cabs was built to deliver safe, professional transport with a friendly, community-first approach.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">What We Stand For</p>
        <h2>Professional, not distant</h2>
        <p>
          Premium, not overpriced. We believe a great taxi service should feel easy: quick to book, comfortable to ride,
          and respectful from pickup to drop-off.
        </p>
      </article>

      <article class="panel reveal">
        <p class="kicker">Community Focus</p>
        <h2>Proud to serve Chester</h2>
        <p>
          We&apos;re proud to serve Chester and support the people who live, work, and visit here &mdash; from daily commutes to
          special occasions.
        </p>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <article class="panel reveal cta-band">
        <p class="kicker">Safety &amp; Standards</p>
        <h2>Your peace of mind matters</h2>
        <p>DeeDash is built on strong standards:</p>
        <ul class="feature-list">
          <li>DBS/background-checked drivers</li>
          <li>ID checks and right-to-work checks</li>
          <li>Vehicle inspections and regular maintenance</li>
          <li>Driver training, including customer service and safeguarding awareness</li>
        </ul>
      </article>
    </div>
  </section>
</SiteLayout>
