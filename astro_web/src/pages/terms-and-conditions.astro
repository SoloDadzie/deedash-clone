---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Terms &amp; Conditions | DeeDash Cabs"
  description="Dummy terms and conditions page for DeeDash Cabs website."
  currentPath="/terms-and-conditions"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Legal</p>
      <h1>Terms &amp; conditions</h1>
      <p>This is a placeholder page for DeeDash Cabs terms and conditions.</p>
      <div class="page-hero-cta">
        <a class="btn btn-accent" href="/contact-us">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">Status</p>
        <h2>Dummy content</h2>
        <p>
          Last updated: 11 February 2026. This page is currently a design placeholder and does not yet contain
          legally binding terms.
        </p>
      </article>

      <article class="panel reveal">
        <p class="kicker">Scope</p>
        <h2>What this page will cover</h2>
        <ul class="feature-list">
          <li>Booking terms and fare conditions</li>
          <li>Passenger responsibilities and safety conduct</li>
          <li>Cancellations, delays, and refunds</li>
          <li>Liability limits and complaints process</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <article class="panel reveal cta-band">
        <p class="kicker">Next Step</p>
        <h2>Legal copy pending</h2>
        <p>
          Replace this placeholder with solicitor-reviewed legal text before the website goes live.
        </p>
      </article>
    </div>
  </section>
</SiteLayout>
