---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Cookie Policy | DeeDash Cabs"
  description="Dummy cookie policy page for DeeDash Cabs website."
  currentPath="/cookie-policy"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Legal</p>
      <h1>Cookie policy</h1>
      <p>This is a placeholder page for DeeDash Cabs cookie policy.</p>
      <div class="page-hero-cta">
        <a class="btn btn-accent" href="/contact-us">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">Status</p>
        <h2>Dummy content</h2>
        <p>
          Last updated: 11 February 2026. This page is a placeholder and does not yet contain final cookie declarations.
        </p>
      </article>

      <article class="panel reveal">
        <p class="kicker">Cookie Types</p>
        <h2>What this page will cover</h2>
        <ul class="feature-list">
          <li>Essential cookies needed for site functionality</li>
          <li>Analytics cookies for traffic insights</li>
          <li>Preference cookies for remembering user settings</li>
          <li>Cookie consent controls and withdrawal process</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <article class="panel reveal cta-band">
        <p class="kicker">Next Step</p>
        <h2>Cookie notice pending</h2>
        <p>
          Replace this placeholder with a complete cookie inventory and consent mechanism details before launch.
        </p>
      </article>
    </div>
  </section>
</SiteLayout>
