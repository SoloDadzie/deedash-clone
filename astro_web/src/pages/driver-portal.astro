---
import SiteLayout from '../layouts/SiteLayout.astro';
import { contactDetails } from '../data/site';
---

<SiteLayout
  title="Driver Portal | DeeDash Cabs"
  description="Apply to drive with DeeDash Cabs and access flexible working, strong earning potential, and local team support in Chester."
  currentPath="/driver-portal"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Driver Portal</p>
      <h1>DRIVE WITH DEEDASH CABS</h1>
      <p>Flexible hours, strong earning potential, and a local team that supports you.</p>
      <div class="page-hero-cta">
        <a class="btn btn-accent" href="#apply">Apply to Drive</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">Why Drive With Us</p>
        <h2>JOIN A TEAM THAT BACKS YOU</h2>
        <ul class="feature-list">
          <li>Flexible working: choose shifts that fit around your life.</li>
          <li>Earning potential: drive more, earn more with consistent local demand.</li>
          <li>Supportive team: straightforward onboarding and help when you need it.</li>
          <li>Professional standards: safety, service, and community matter here.</li>
        </ul>
      </article>

      <article class="panel reveal">
        <p class="kicker">What You&apos;ll Need</p>
        <h2>PUBLIC-FACING REQUIREMENTS</h2>
        <p>To apply, you should have:</p>
        <ul class="feature-list">
          <li>A valid private hire/taxi licence (local authority requirements apply).</li>
          <li>A DBS/background check (or willingness to complete one).</li>
          <li>A professional attitude and strong local customer service.</li>
        </ul>
        <p class="microcopy">Vehicle details and additional checks can be discussed during the application.</p>
      </article>
    </div>
  </section>

  <section id="apply" class="section-sm">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">How to Apply</p>
        <h2>APPLY THE WAY THAT SUITS YOU</h2>
        <ul class="plain-list">
          <li><strong>Apply online:</strong> [APPLY FORM LINK / EMBED FORM]</li>
          <li><strong>WhatsApp:</strong> {contactDetails.whatsapp}</li>
          <li><strong>Call:</strong> {contactDetails.phone}</li>
          <li><strong>Email:</strong> {contactDetails.email}</li>
        </ul>
        <a class="btn btn-primary" href="/contact-us">Apply to Drive</a>
      </article>

      <article class="panel reveal cta-band">
        <p class="kicker">Vehicle Options</p>
        <h2>HAVE YOUR OWN CAR OR NEED A VEHICLE?</h2>
        <p>
          We can work with drivers who use their own vehicle, and we can also discuss vehicle rental/lease options.
        </p>
        <a class="btn btn-accent" href="/contact-us">Apply to Drive</a>
      </article>
    </div>
  </section>
</SiteLayout>
