---
import SiteLayout from '../layouts/SiteLayout.astro';
import { contactDetails } from '../data/site';
---

<SiteLayout
  title="Book a Ride | DeeDash Cabs"
  description="Book a DeeDash ride in Chester for ASAP pickups, scheduled trips, and airport transfers with instant confirmation."
  currentPath="/book-a-ride"
>
  <section class="page-hero">
    <div class="container page-hero-content reveal">
      <p class="eyebrow">Booking Made Simple</p>
      <h1>Book a ride in Chester &mdash; fast and simple</h1>
      <p>Request an ASAP pickup or schedule ahead. You&apos;ll get instant confirmation on screen, plus SMS/email.</p>
      <div class="page-hero-cta">
        <a class="btn btn-accent" href="#booking-form">Request a Ride</a>
        <a class="btn btn-ghost" href={`tel:${contactDetails.phoneTel}`}>Call to Book: {contactDetails.phone}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="panel reveal">
        <p class="kicker">Booking Options</p>
        <h2>Choose what works for you</h2>
        <ul class="feature-list">
          <li>ASAP pickup for quick trips</li>
          <li>Pre-book / schedule for planned journeys</li>
          <li>Airport transfers for stress-free travel</li>
        </ul>
      </article>

      <article class="panel reveal">
        <p class="kicker">Pricing</p>
        <h2>Fares that stay clear</h2>
        <p>
          Fares are based on time and distance (meter-style). If you&apos;d like a rough estimate before you travel, call us,
          and we&apos;ll help.
        </p>
        <a class="btn btn-primary" href={`tel:${contactDetails.phoneTel}`}>Call to Book: {contactDetails.phone}</a>
      </article>
    </div>
  </section>

  <section id="booking-form" class="section-sm">
    <div class="container">
      <article class="panel reveal">
        <p class="kicker">Booking Form</p>
        <h2>Request a ride</h2>
        <form
          class="booking-form-wide"
          action="/book-a-ride#booking-form"
          method="get"
          novalidate
          hx-get="/partials/ride-request-confirmation"
          hx-target="#ride-request-response"
          hx-swap="innerHTML"
          hx-indicator="#ride-request-loading"
        >
          <label>
            Pickup location
            <input type="text" name="pickup" placeholder="Start typing your address" />
          </label>
          <label>
            Drop-off location
            <input type="text" name="dropoff" placeholder="Where are you going?" />
          </label>
          <label>
            Date &amp; time
            <input type="text" name="time" placeholder="Choose &quot;Now&quot; for ASAP pickup" />
          </label>
          <label>
            Passengers
            <input type="text" name="passengers" placeholder="Suitable for solo travellers to small groups" />
          </label>
          <label>
            Luggage
            <input type="text" name="luggage" placeholder="Optional &mdash; helps us send the best vehicle" />
          </label>
          <label>
            Payment method
            <select name="payment">
              <option>Cash</option>
              <option>Card in car</option>
            </select>
          </label>
          <label class="span-2">
            Notes for driver
            <textarea name="notes" placeholder="Optional &mdash; e.g., ring the side doorbell"></textarea>
          </label>
          <label>
            Your name
            <input type="text" name="name" placeholder="Full name" />
          </label>
          <label>
            Mobile number
            <input type="tel" name="mobile" placeholder="For updates and confirmation" />
          </label>
          <label class="span-2">
            Email address
            <input type="email" name="email" placeholder="For confirmation and receipt" />
          </label>
          <button class="btn btn-primary span-2" type="submit">Request a Ride</button>
        </form>
        <p id="ride-request-loading" class="microcopy htmx-indicator">Sending your request...</p>
        <div id="ride-request-response" class="htmx-response" aria-live="polite"></div>
        <p class="microcopy">Instant confirmation on screen + SMS/email confirmation.</p>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <article class="panel reveal cta-band">
        <p class="kicker">Airport Transfers</p>
        <h2>Airport transfers made easy</h2>
        <p>Pre-book your airport journey for a smooth, on-time pickup. We regularly travel to:</p>
        <ul class="feature-list">
          <li>Manchester Airport (MAN)</li>
          <li>Liverpool John Lennon (LPL)</li>
          <li>Birmingham (BHX)</li>
          <li>London airports (long-distance)</li>
        </ul>
        <p class="microcopy">Flight tracking / meet-and-greet: coming soon.</p>
        <a class="btn btn-accent" href="#booking-form">Request a Ride</a>
      </article>
    </div>
  </section>
</SiteLayout>
