---
import SiteLayout from '../layouts/SiteLayout.astro';
import { contactDetails } from '../data/site';
---

<SiteLayout
  title="DeeDash Cabs | Chester Private Hire"
  description="DeeDash Cabs offers safe, friendly private hire across Chester and nearby areas, from local trips to airport transfers and business travel."
  currentPath="/"
>
  <section class="hero">
    <div class="hero-media" role="img" aria-label="Premium taxi passing Chester Eastgate Clock at dusk"></div>
    <div class="hero-overlay"></div>

    <div class="container hero-content reveal">
      <p class="eyebrow">Private Hire in Chester &amp; Environs</p>
      <h1 class="hero-title">
        <span>Premium Rides. Great Value.</span>
        <span>Ready when you are.</span>
      </h1>
      <p class="hero-subtitle">
        DeeDash Cabs offers safe, friendly private hire across Chester &mdash; from quick local trips to airport transfers and business travel.
      </p>

      <div class="hero-ctas">
        <a class="btn btn-accent" href="/book-a-ride">Request a Ride</a>
        <a class="btn btn-ghost" href={`tel:${contactDetails.phoneTel}`}>Call to Book: {contactDetails.phone}</a>
      </div>

      <p class="trust-line">24/7 service &bull; DBS-checked drivers &bull; Card or cash accepted</p>
    </div>
  </section>

  <section class="booking-strip reveal">
    <div class="container">
      <div class="booking-shell">
        <div class="booking-panel">
          <p class="booking-panel__eyebrow">Instant Bookings</p>
          <h2>Book In Seconds</h2>
          <p class="booking-panel__lead">
            Confirm your ride in moments &mdash; perfect for airport runs, business travel, and last-minute city trips.
          </p>

          <ul class="booking-panel__highlights">
            <li>Live driver ETA &amp; tracking links for every journey</li>
            <li>Instant SMS and email confirmations</li>
            <li>Cashless payments with receipts sent automatically</li>
          </ul>

          <div class="booking-panel__contact">
            <div>
              <span>Need help?</span>
              <strong>{contactDetails.phone}</strong>
            </div>
            <a class="btn btn-outline" href={`tel:${contactDetails.phoneTel}`}>Call Dispatch</a>
          </div>
        </div>

        <form
          class="booking-form"
          action="/book-a-ride#booking-form"
          method="get"
          novalidate
          hx-get="/partials/quick-booking"
          hx-target="#quick-booking-response"
          hx-swap="innerHTML"
          hx-indicator="#quick-booking-loading"
        >
          <div class="booking-form__grid">
            <label>
              <span>Pickup Location</span>
              <input type="text" name="pickup" placeholder="Start typing your address" />
            </label>
            <label>
              <span>Drop-off Location</span>
              <input type="text" name="dropoff" placeholder="Where are you going?" />
            </label>
            <label>
              <span>Now / Schedule</span>
              <input type="text" name="time" placeholder='Choose "Now" or enter a date' />
            </label>
            <label>
              <span>Passengers</span>
              <input type="text" name="passengers" placeholder="Solo travellers to small groups" />
            </label>
          </div>

          <div class="booking-form__actions">
            <p>Instant confirmation plus driver + vehicle details before pickup.</p>
            <button class="btn btn-primary" type="submit">Request a Ride</button>
          </div>
        </form>
        <p id="quick-booking-loading" class="microcopy htmx-indicator">Checking immediate availability...</p>
        <div id="quick-booking-response" class="htmx-response" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <section class="section why">
    <div class="container">
      <h2 class="section-title reveal">Why Choose DeeDash Cabs?</h2>
      <div class="benefit-grid">
        <article class="benefit-card reveal">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <circle cx="7" cy="8" r="3"></circle>
              <circle cx="17" cy="8" r="3"></circle>
              <path d="M4 20v-2a4 4 0 0 1 4-4h0a4 4 0 0 1 4 4v2H4zm8 0v-2a4 4 0 0 1 4-4h0a4 4 0 0 1 4 4v2z"></path>
            </svg>
          </div>
          <h3>Professional &amp; Friendly</h3>
          <p>Polite drivers and a clean, comfortable ride&mdash;every time.</p>
        </article>
        <article class="benefit-card reveal">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <path d="M12 3 4 7v5c0 5.52 3.84 10.74 8 12 4.16-1.26 8-6.48 8-12V7z"></path>
              <path d="m11 13 3-3 1.5 1.5-4.5 4.5-3-3L9 11.5z"></path>
            </svg>
          </div>
          <h3>Safety First</h3>
          <p>DBS checks, ID and right-to-work checks, and trained drivers.</p>
        </article>
        <article class="benefit-card reveal">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <path d="M12 2 9.19 8.26 2.5 9.27l4.9 4.78L5.82 21 12 17.77 18.18 21l-1.58-6.95 4.9-4.78-6.69-1.01z"></path>
            </svg>
          </div>
          <h3>Great Value</h3>
          <p>A premium experience with fair, sensible pricing.</p>
        </article>
        <article class="benefit-card reveal">
          <div class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v6l4 2"></path>
            </svg>
          </div>
          <h3>Always Available</h3>
          <p>24/7 bookings and support when you need it.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section services">
    <div class="container">
      <h2 class="section-title reveal">Popular Services</h2>
      <div class="service-grid showcase">
        <article class="service-card reveal">
          <div class="service-card__media">
            <img src="/assets/images/service-airport.jpg" alt="Executive DeeDash cab ready for airport transfer" />
          </div>
          <div class="service-card__body">
            <h3>Airport Transfers</h3>
            <p>Direct, stress-free trips to Manchester (MAN), Liverpool (LPL), Birmingham (BHX) and London airports.</p>
            <a class="btn btn-outline service-card__cta" href="/book-a-ride">Request a Ride</a>
          </div>
        </article>

        <article class="service-card reveal">
          <div class="service-card__media">
            <img src="/assets/images/service-school.jpg" alt="School run passengers boarding DeeDash vehicle" />
          </div>
          <div class="service-card__body">
            <h3>School Runs</h3>
            <p>Reliable, consistent transport with drivers trained in safeguarding&mdash;providing a safe, supportive service you can trust.</p>
            <a class="btn btn-outline service-card__cta" href="/book-a-ride">Request a Ride</a>
          </div>
        </article>

        <article class="service-card reveal">
          <div class="service-card__media">
            <img src="/assets/images/service-medical.jpg" alt="Medical passenger being helped towards hospital" />
          </div>
          <div class="service-card__body">
            <h3>Medical &amp; Hospital Trips</h3>
            <p>Non-emergency journeys to clinics and hospitals with care and professionalism.</p>
            <a class="btn btn-outline service-card__cta" href="/book-a-ride">Request a Ride</a>
          </div>
        </article>

        <article class="service-card reveal">
          <div class="service-card__media">
            <img src="/assets/images/service-events.jpg" alt="Wedding party using DeeDash chauffeur service" />
          </div>
          <div class="service-card__body">
            <h3>Events &amp; Weddings</h3>
            <p>Arrive on time and travel together&mdash;perfect for evenings out and special occasions.</p>
            <a class="btn btn-outline service-card__cta" href="/book-a-ride">Request a Ride</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="business-feature reveal">
    <div class="business-feature__wrapper">
      <div class="business-feature__media">
        <img src="/assets/images/business-travel.jpg" alt="Executive traveler in yellow cab queue" />
      </div>

      <div class="business-feature__content">
        <p class="business-feature__eyebrow">Corporate Travel</p>
        <h2>Your first choice for travelling anywhere</h2>
        <p>
          Need reliable travel for staff, clients, or guests? DeeDash Business Solutions provides priority support, instant confirmations, and concierge-style coordination across Chester and beyond.
        </p>

        <div class="business-feature__highlight">
          <div>
            <h3 class="business-feature__highlight-title">We specialise in premium, high-quality service</h3>
            <p class="business-feature__highlight-desc">Executive vehicles, trained chauffeurs, and always-on dispatch for your team.</p>
          </div>
          <div class="business-feature__highlight-media">
            <img src="/assets/images/service-events.jpg" alt="Driver assisting passenger by car" />
            <button class="business-feature__play" type="button" aria-label="Play overview video">
              <span></span>
            </button>
          </div>
        </div>

        <div class="business-feature__contact">
          <div class="business-feature__contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <path d="M6.6 2.01a1 1 0 0 1 1.08.33l2.28 2.9a1 1 0 0 1 .07 1.12l-1.3 2.3a.5.5 0 0 0 .02.52 11.4 11.4 0 0 0 4.21 4.2.5.5 0 0 0 .52.02l2.29-1.3a1 1 0 0 1 1.12.07l2.9 2.28a1 1 0 0 1 .33 1.08l-.77 2.64a1.5 1.5 0 0 1-1.44 1.08c-9.17-.24-16.55-7.62-16.79-16.79a1.5 1.5 0 0 1 1.08-1.44z" />
            </svg>
          </div>
          <div>
            <p class="contact-label">Call us now</p>
            <a href={`tel:${contactDetails.phoneTel}`}>{contactDetails.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="driver-feature reveal">
    <div class="driver-feature__wrapper">
      <div class="driver-feature__content">
        <h2>Professional And Dedicated Online Taxi Services</h2>
        <p class="driver-feature__lead">
          Looking for high earnings and flexible hours with a supportive local team?
        </p>
        <a class="btn btn-primary driver-feature__cta" href={`mailto:${contactDetails.email}?subject=Driver%20Portal`}>
          Driver Portal
        </a>
      </div>

      <div class="driver-feature__media-block">
        <div class="driver-feature__media">
          <img src="/assets/images/driver.jpg" alt="Professional female chauffeur driving clients" />
        </div>
      </div>
    </div>
  </section>

  <section class="section coverage">
    <div class="container coverage-grid">
      <div class="coverage-card reveal">
        <p class="coverage-eyebrow">Coverage Map</p>
        <h2 class="section-title">Serving Chester And Nearby Areas</h2>
        <p class="coverage-lead">
          Priority pickups across Chester city centre, Hoole, Handbridge, Ellesmere Port, Wrexham, Deeside, Chester Business Park,
          and surrounding villages.
        </p>

        <div class="coverage-stats">
          <div>
            <span>20+</span>
            <p>areas covered daily</p>
          </div>
          <div>
            <span>15 min</span>
            <p>average city pickup</p>
          </div>
          <div>
            <span>24/7</span>
            <p>airport transfers</p>
          </div>
        </div>

        <div class="coverage-tags">
          <span>Chester City</span>
          <span>Hoole &amp; Upton</span>
          <span>Ellesmere Port</span>
          <span>Wrexham</span>
          <span>Deeside</span>
          <span>Business Park</span>
        </div>

        <div class="coverage-cta">
          <p>Not sure if we cover your pickup? Call dispatch and we'll confirm in seconds.</p>
          <a class="btn btn-primary" href={`tel:${contactDetails.phoneTel}`}>Call to Book: {contactDetails.phone}</a>
        </div>
      </div>

      <div class="coverage-map reveal" aria-hidden="true">
        <div class="coverage-map__frame">
          <img src="/assets/images/chester-rows.jpg" alt="Chester city landmark" />
          <div class="map-pin pin-1">
            <span>Chester City</span>
          </div>
          <div class="map-pin pin-2">
            <span>Airport Runs</span>
          </div>
          <div class="map-pin pin-3">
            <span>Business Travel</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
